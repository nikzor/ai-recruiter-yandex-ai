AI_MODE=mock
API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=yandexgpt-5.1
PORT=3001

# SpeechKit TTS uses the same server API_KEY; requires ai.speechkit-tts.user.
TTS_ENABLED=true
TTS_VOICE=filipp

# SpeechKit streaming recognition; requires ai.speechkit-stt.user.
STT_ENABLED=true

# Yandex Realtime uses API_KEY + YANDEX_FOLDER_ID; requires ai.models.user.
REALTIME_ENABLED=true
REALTIME_MODEL=speech-realtime-deepseek-v4-flash
REALTIME_VOICE=filipp
# speechkit = fast MP3 synthesis; native = audio generated by Realtime.
REALTIME_TTS=speechkit
